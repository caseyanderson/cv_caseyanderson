{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Education",
  "type": "object",
  "required": [
    "id",
    "title",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "education"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "degree",
          "major",
          "institution",
          "location",
          "time"
        ],
        "properties": {
          "degree": {
            "type": "string"
          },
          "major": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "institution": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "time": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "date"
              },
              "value": {
                "$ref": "urn:cv-caseyanderson:schema:date-component"
              }
            }
          }
        }
      }
    }
  }
}
