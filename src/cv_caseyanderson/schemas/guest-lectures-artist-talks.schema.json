{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guest Lectures & Artist Talks",
  "type": "object",
  "required": [
    "id",
    "title",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "guest-lectures-artist-talks"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "institution",
          "title",
          "context",
          "location",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "institution": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "required": [
              "name",
              "host"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "host": {
                "type": "string"
              }
            }
          },
          "location": {
            "type": "string"
          },
          "time": {
            "oneOf": [
              {
                "$ref": "#/$defs/date"
              },
              {
                "$ref": "#/$defs/dates"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "$ref": "urn:cv-caseyanderson:schema:single-date"
    },
    "dates": {
      "$ref": "urn:cv-caseyanderson:schema:dates"
    }
  }
}
