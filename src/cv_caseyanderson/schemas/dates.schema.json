{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cv-caseyanderson:schema:dates",
  "title": "CV multiple dates",
  "type": "object",
  "required": [
    "kind",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "dates"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:cv-caseyanderson:schema:date-component"
      }
    }
  }
}
