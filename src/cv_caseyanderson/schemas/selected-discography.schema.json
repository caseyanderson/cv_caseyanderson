{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected Discography",
  "type": "object",
  "required": [
    "id",
    "title",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "selected-discography"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "artists",
          "formats",
          "record_label",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "artists": {
            "$ref": "#/$defs/nonempty_string_list"
          },
          "formats": {
            "$ref": "#/$defs/nonempty_string_list"
          },
          "record_label": {
            "type": "string"
          },
          "time": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "date"
              },
              "value": {
                "$ref": "urn:cv-caseyanderson:schema:date-component"
              }
            }
          },
          "status": {
            "const": "planned"
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "works": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title",
                "role"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
