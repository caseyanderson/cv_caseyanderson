{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Professional Experience",
  "type": "object",
  "required": [
    "id",
    "title",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "professional-experience"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "organization",
          "role",
          "location",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "organization": {
            "type": "string"
          },
          "role": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "string"
          },
          "time": {
            "$ref": "urn:cv-caseyanderson:schema:interval"
          }
        }
      }
    }
  }
}
