{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Professional Experience",
  "type": "object",
  "required": [
    "id",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "professional-experience"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "organization",
          "role",
          "location",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "organization": {
            "type": "string"
          },
          "role": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "string"
          },
          "time": {
            "$ref": "#/$defs/interval"
          }
        }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "required": [
        "kind",
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interval"
        },
        "start": {
          "$ref": "urn:cv-caseyanderson:schema:date-component"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "urn:cv-caseyanderson:schema:date-component"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
