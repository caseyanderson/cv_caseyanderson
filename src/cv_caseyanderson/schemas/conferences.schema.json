{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conferences",
  "type": "object",
  "required": [
    "id",
    "title",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "conferences"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "conference",
          "collaborators",
          "location",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "conference": {
            "type": "string"
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "string"
          },
          "time": {
            "$ref": "urn:cv-caseyanderson:schema:single-date"
          }
        }
      }
    }
  }
}
