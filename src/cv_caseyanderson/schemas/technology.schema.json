{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology",
  "type": "object",
  "required": ["id", "title", "entries"],
  "additionalProperties": false,
  "properties": {
    "id": {"const": "technology"},
    "title": {"type": "string"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "technology": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "primary": {"type": "boolean"},
        "proficiency": {"enum": ["intermediate"]}
      }
    },
    "entry": {
      "type": "object",
      "required": ["category", "technologies"],
      "additionalProperties": false,
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "technologies": {
          "type": "array",
          "items": {"$ref": "#/$defs/technology"}
        },
        "description": {"type": "string"}
      }
    }
  }
}
