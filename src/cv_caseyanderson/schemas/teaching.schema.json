{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teaching",
  "type": "object",
  "required": [
    "id",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "teaching"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "institution",
          "role",
          "location",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "string"
          },
          "time": {
            "oneOf": [
              {
                "$ref": "urn:cv-caseyanderson:schema:interval"
              },
              {
                "$ref": "#/$defs/dates"
              }
            ]
          },
          "institution": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "dates": {
      "type": "object",
      "required": [
        "kind",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "dates"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:cv-caseyanderson:schema:date-component"
          }
        }
      }
    }
  }
}
