{% macro render_education_entry(entry) -%}
<span class="boxed">
    {{- entry.degree }} in {{ entry.concentration | default("", true) or entry.major | join(", ") -}}
</span>
{{- ", " }}{{ entry.institution }}
{{- ", " }}{{ entry.location }}
{{- ", " -}}
<time datetime="{{ entry.time.value.year }}">
    {{- entry.time.value.year -}}
</time>
{%- endmacro %}

{% macro render_date_component(date, show_day=true, show_month=true) -%}
    {%- set month_names = [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
    ] -%}

    {%- set has_month = date.month is defined and date.month is not none -%}
    {%- set has_day = date.day is defined and date.day is not none -%}
    {%- set has_season = date.season is defined and date.season is not none -%}

    <time datetime="{{ date.year }}{% if has_month %}-{{ "%02d" | format(date.month) }}{% endif %}{% if has_day %}-{{ "%02d" | format(date.day) }}{% endif %}">
        {%- if show_month and has_month -%}
            {{ month_names[date.month - 1] }}
            {%- if show_day and has_day -%}
                {{ " " }}{{ date.day }}{{ ", " }}
            {%- else -%}
                {{ " " }}
            {%- endif -%}
        {%- elif show_month and has_season -%}
            {{ date.season | capitalize }}{{ " " }}
        {%- endif -%}
        {{ date.year -}}
    </time>
{%- endmacro %}

{% macro render_interval(interval, show_day=true) -%}
    <span class="time-interval">
        {{- render_date_component(interval.start, show_day=show_day) -}}
        {{ " - " }}
        {%- if interval.end is none -%}
            present
        {%- else -%}
            {{ render_date_component(interval.end, show_day=show_day) }}
        {%- endif -%}
    </span>
{%- endmacro %}

{% macro render_dates(dates) -%}
    <span class="time-values">
        {%- for date in dates["values"] -%}
            {{ render_date_component(date) }}
            {%- if not loop.last -%}
                {{ " & " }}
            {%- endif -%}
        {%- endfor -%}
    </span>
{% endmacro %}

{% macro render_professional_entry(entry) -%}
    <span class="boxed">
        {{- entry.organization -}}
    </span>
    {{- ", " }}{{ entry.role | join(", ") }}
    {{- ", " }}{{ entry.location }}
    {{- ", " }}{{ render_interval(entry.time, show_day=false) }}
{%- endmacro %}

{% macro render_teaching_entry(entry) -%}
    <span class="boxed">
        {{- entry.institution -}}
    </span>
    {{- ", " }}{{ entry.role | join(", ") }}
    {{- ", " }}{{ entry.location }}
    {{- ", " }}
    {%- if entry.time.kind == "interval" -%}
        {{ render_interval(entry.time) }}
    {%- elif entry.time.kind == "dates" -%}
        {{ render_dates(entry.time) }}
    {%- endif -%}
{%- endmacro %}

{% macro render_guest_lecture_entry(entry) -%}
    <span class="boxed">
        {{- entry.institution -}}
    </span>
    {{- ", " }}{{ entry.title }}
    {{- ", " }}{{ entry.context.name }}
    {{- " (hosted by " }}{{ entry.context.host }}{{ ")" }}
    {{- ", " }}{{ entry.location }}
    {{- ", " }}
    {%- if entry.time.kind == "date" -%}
        {{ render_date_component(entry.time.value) }}
    {%- elif entry.time.kind == "dates" -%}
        {{ render_dates(entry.time) }}
    {%- endif -%}
{%- endmacro %}

{% macro render_organizations(organizations) -%}
    <span class="boxed">
        {{- organizations.primary.name -}}
    </span>
    {%- for organization in organizations.additional -%}
        {{- ", " }}{{ organization.name }}
    {%- endfor -%}
{%- endmacro %}

{% macro render_awards_events_entry(entry) -%}
    {{- render_organizations(entry.organizations) -}}
    {{- ", " }}{{ entry.title }}

    {%- if entry.collaborators -%}
        {{- " (w/ " }}
        {{- entry.collaborators | join(", ") -}}
        {{- ")" }}
    {%- endif -%}

    {%- if entry.part_of is defined -%}
        {%- set organization_names = [
            entry.organizations.primary.name
        ] + (
            entry.organizations.additional
            | map(attribute="name")
            | list
        ) -%}

        {%- if entry.part_of.title not in organization_names -%}
            {{- ", " }}{{ entry.part_of.title }}

            {%- if entry.part_of.collaborators is defined
                and entry.part_of.collaborators -%}
                {{- " (w/ " }}
                {{- entry.part_of.collaborators | join(", ") -}}
                {{- ")" }}
            {%- endif -%}
        {%- endif -%}
    {%- endif -%}

    {%- if entry.role is defined -%}
        {{- ", " }}{{ entry.role }}
    {%- endif -%}

    {%- if entry.mentors is defined -%}
        {{- " (mentored by " }}
        {{- entry.mentors | join(", ") -}}
        {{- ")" }}
    {%- endif -%}

    {{- ", " }}{{ entry.location }}
    {{- ", " }}

    {%- if entry.cohort_year is defined -%}
        <time datetime="{{ entry.cohort_year }}">
            {{- entry.cohort_year -}}
        </time>
    {%- elif entry.time.kind == "date" -%}
        {{ render_date_component(entry.time.value) }}
    {%- elif entry.time.kind == "interval" -%}
        {{ render_interval(entry.time) }}
    {%- elif entry.time.kind == "dates" -%}
        {{ render_dates(entry.time) }}
    {%- endif -%}
{%- endmacro %}

{% macro render_conference_entry(entry) -%}
    <span class="boxed">
        {{- entry.title -}}
    </span>
    {%- if entry.collaborators -%}
        {{- " (w/ " }}
        {{- entry.collaborators | join(", ") -}}
        {{- ")" }}
    {%- endif -%}
    {{- ", " }}{{ entry.conference }}
    {{- ", " }}{{ entry.location }}
    {{- ", " }}{{ render_date_component(entry.time.value) }}
{%- endmacro %}

{% macro render_publication_entry(entry) -%}
    <a href="{{ entry.url }}" target="_blank" rel="noopener">
        {{- entry.label -}}
    </a>
    {{- " " }}{{ entry.publication }}
    {{- ", " }}{{ render_date_component(entry.time.value) }}
{%- endmacro %}

{% macro render_discography_entry(entry) -%}
    {%- set planned = entry.status | default("") == "planned" -%}
    {%- if planned %}({% endif -%}
    <span class="boxed">{{ entry.title }}</span>
    {{- ", " }}{{ entry.artists | join(" / ") }}
    {{- ", " }}{{ entry.formats | join(" / ") }}
    {{- ", " }}{{ entry.record_label }}
    {{- ", " }}{{ render_date_component(entry.time.value, show_month=false) }}
    {%- if planned %}){% endif -%}
{%- endmacro %}

{% macro render_design_production_entry(entry) -%}
    <span class="boxed">
        {%- if entry.director is defined -%}
            {{ entry.director }}{{ "'s " }}
        {%- elif entry.composer is defined and entry.composer not in entry.title -%}
            {{ entry.composer }}{{ "'s " }}
        {%- endif -%}
        {{ entry.title -}}
    </span>
    {%- if entry.collaborators is defined and entry.collaborators -%}
        {{- " (w/ " }}{{ entry.collaborators | join(", ") }}{{ ")" }}
    {%- endif -%}
    {{- ", " }}{{ entry.role | join(", ") }}
    {%- if entry.part_of is defined -%}
        {{- ", " }}{{ entry.part_of.title }}
    {%- endif -%}
    {%- if entry.organizations is defined -%}
        {{- ", " }}{{ entry.organizations.primary.name }}
        {%- for organization in entry.organizations.additional -%}
            {{- ", " }}{{ organization.name }}
            {%- if "producer" in organization.roles -%}
                {{ " (production)" }}
            {%- elif "presenter" in organization.roles -%}
                {{ " (presenter)" }}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
    {%- if entry.record_label is defined -%}
        {{- ", " }}{{ entry.record_label }}
    {%- endif -%}
    {%- if entry.location is defined -%}
        {{- ", " }}{{ entry.location }}
    {%- endif -%}
    {{- ", " }}
    {%- if entry.time.kind == "interval" -%}
        {{ render_interval(entry.time) }}
    {%- elif entry.time.kind == "dates" -%}
        {{ render_dates(entry.time) }}
    {%- elif entry.record_label is defined -%}
        {{ render_date_component(entry.time.value, show_month=false) }}
    {%- else -%}
        {{ render_date_component(entry.time.value) }}
    {%- endif -%}
{%- endmacro %}

{% macro render_technology_entry(entry) -%}
    <span class="boxed">{{ entry.category }}</span>
    {%- if entry.technologies -%}
        {{- " " -}}
        {%- for technology in entry.technologies -%}
            {%- if not loop.first -%}{{ ", " }}{%- endif -%}
            {{ technology.name }}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro %}
