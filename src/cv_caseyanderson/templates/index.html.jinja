{% macro render_education_entry(entry) -%}
<span class="boxed">{{ entry.degree }} in {{ entry.major | join(", ") }}</span>, {{ entry.institution }}, {{ entry.location }}, <time datetime="{{ entry.time.value.year }}">{{ entry.time.value.year }}</time>
{%- endmacro %}
{% macro render_entry(entry) -%}
{%- if entry.type == "boxed" -%}
{{ entry.prefix | default("") }}<span class="boxed">{{ entry.label }}</span>{% if entry.details %}, {{ entry.details }}{% endif %}{{ entry.suffix | default("") }}
{%- elif entry.type == "link" -%}
<a href="{{ entry.url }}" target="_blank" rel="noopener">{{ entry.label }}</a>{% if entry.details %} {{ entry.details }}{% endif %}
{%- elif entry.type == "plain" -%}
{{ entry.text }}
{%- endif -%}
{%- endmacro %}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Casey Anderson - Curriculum Vitae</title>
        <link rel="stylesheet" href="styles.css" type="text/css">
    </head>

    <body>
        {% for section in sections %}
        <div id="{{ section.id }}">
            <h2>{{ section.title }}</h2>
            {% if section.id == "education" %}
                <ul class="nobullets current">
                    {% for entry in section.entries %}
                    <li>{{ render_education_entry(entry) }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                {% for group in section.groups %}
                    {% if group.title %}
                        <h3>{{ group.title }}</h3>
                    {% endif %}
                    <ul class="{{ group.classes | join(' ') }}">
                        {% for entry in group.entries %}
                            <li>{{ render_entry(entry) }}</li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            {% endif %}
        </div>
        {% endfor %}
    </body>
</html>
